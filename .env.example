APP_NAME=StyloBiz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# `daily` rotates storage/logs/laravel-YYYY-MM-DD.log and keeps LOG_DAILY_DAYS
# of them — a single ever-growing laravel.log eventually fills a shared-hosting
# disk. In production also set LOG_LEVEL=warning (debug logs every query/detail).
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Super Admin > Error log: days an error stays listed after it was last seen.
ERROR_LOG_RETENTION_DAYS=90

# Nightly backup (02:00 via the scheduler) — see docs/DEPLOYMENT.md, Backups.
# Archives are written to storage/backups (outside the web root); the newest
# few are always kept, older than BACKUP_RETENTION_DAYS are pruned.
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_UPLOADS=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beauty_saas
DB_USERNAME=root
DB_PASSWORD=

# Seeded once by PlatformAdminSeeder — change before any shared/production deploy.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=password
PLATFORM_BRAND_NAME=StyloBiz

# GST on Platform Billing (config/platform.php) — 18% is the standard rate
# for software/SaaS services in India. Fill in PLATFORM_GSTIN once you have
# a real GST registration; it's shown on invoices when set. PLATFORM_STATE
# is the platform's own registered state — compared against each tenant's
# Tenant.billing_state to decide CGST+SGST (same state) vs IGST (different
# state) on their subscription invoice.
PLATFORM_GST_RATE_PERCENT=18
PLATFORM_GSTIN=
PLATFORM_GST_SAC_CODE=998313
PLATFORM_STATE=Haryana

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production over HTTPS: set this to true so session/CSRF cookies are
# never sent over plain HTTP. Leave unset (defaults to auto-detect) for
# local http:// development — see docs/DEPLOYMENT.md.
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Phase 11 notifications (config/notifications.php) — 'null' logs instead
# of sending, safe by default. Only change once DLT/TRAI (SMS) and
# WhatsApp Business API registration are actually in place (CLAUDE.md §36).
NOTIFICATIONS_SMS_DRIVER=null
NOTIFICATIONS_WHATSAPP_DRIVER=null

# Platform billing (config/payments.php) — 'null' shows a "not configured
# yet" message instead of calling a real gateway. Sign up at razorpay.com,
# generate TEST-MODE keys (rzp_test_...), fill these in, then set
# PAYMENTS_DRIVER=razorpay. Never commit real keys to this file.
PAYMENTS_DRIVER=null
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional, needs no payment gateway at all — a scannable UPI QR shown on a
# pending Quotation (Platform + tenant billing pages), encoding your own
# UPI ID so anyone with GPay/PhonePe/Paytm/etc. can pay you directly. Not
# auto-reconciled — you still confirm the payment landed and use the
# existing "Record payment" action. Hidden entirely until PLATFORM_UPI_VPA
# is set.
PLATFORM_UPI_VPA=
PLATFORM_UPI_PAYEE_NAME=

# Your GST identity on Platform invoices/quotations (GST is your own detail —
# leave blank until you have it, but a GST invoice needs your GSTIN on it).
# PLATFORM_STATE decides CGST+SGST (same state as the tenant) vs IGST.
PLATFORM_GSTIN=
PLATFORM_STATE=Haryana
PLATFORM_GST_RATE_PERCENT=18

# Optional: shown as "Questions? Write to ..." at the foot of billing emails
# (quotation, payment received, renewal reminders).
PLATFORM_SUPPORT_EMAIL=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
